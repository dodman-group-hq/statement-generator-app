# Neon connection string (Neon dashboard -> your project -> Connection Details).
# Keep the sslmode=require Neon includes by default.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# REQUIRED when APP_ENV=production (the default): the app refuses to start
# without it. Signup/login sessions are signed with this key, so it must stay
# the same across restarts/deploys or every user is logged out. Set it to the
# SAME value as Vett's SESSION_SECRET_KEY for cross-product session
# compatibility later - even though sessions aren't shared cross-domain
# yet (neither app's cookie sets an explicit `domain=`), matching values
# now means turning that on later is a config change, not a migration.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# (For local development only, set APP_ENV=development to allow a random
# per-process key instead.)
SESSION_SECRET_KEY=

# Optional - defaults to 25 if not set
MAX_UPLOAD_MB=25

# Optional - error tracking. Leave unset to run with no Sentry account at all;
# the app works identically either way. Get a DSN from sentry.io -> your
# project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

#6 Optional - defaults to 2 if not set. Controls how many LibreOffice processes can run at once. 
LIBREOFFICE_CONCURRENCY=2

#6 Optional - defaults to 3 if not set. Controls how many statement generation jobs can run at once.
MAX_CONCURRENT_JOBS=3

# Optional - defaults to 8388608 (8 MB) if not set. Controls how many bytes of
# generated .docx are sent to LibreOffice in one batch. Must be a plain integer
# (no expressions) - it is read with int().
CONVERSION_BATCH_TARGET_BYTES=8388608

#6 Optional - defaults to 30 if not set. Controls how many rows of data can be processed in a single batch.
CONVERSION_MAX_BATCH_SIZE=30

#6 Optional - defaults to 2 if not set. Controls how many consecutive failures are allowed before the circuit breaker trips and stops processing new jobs.
CIRCUIT_BREAKER_THRESHOLD=2

# Optional - shown as the "environment" tag on Sentry events, e.g. production / staging
APP_ENV=production

# ---------------------------------------------------------------------------
# Billing (Paystack). PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET, APP_BASE_URL and both plan codes must be set for /billing to
# be enabled; if any is missing the app starts normally with billing off.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
# Paystack signs webhooks with your SECRET key, so this is normally the same value.
PAYSTACK_WEBHOOK_SECRET=
# Paystack plan codes (Paystack dashboard -> Plans). Create these as SEPARATE plans from
# Vett's - the billing package tells products apart by plan code. Free needs none.
PAYSTACK_PLAN_SG_STARTER=
PAYSTACK_PLAN_SG_PRO=
# Public base URL of this app, no trailing slash. Used for Paystack's callback and email links.
APP_BASE_URL=https://example.com

# Optional - transactional email via Resend: welcome, new-key notices, usage-limit notices,
# billing receipts (and password reset, next). Both required to send; without them the app
# only logs that an email would have been sent. The sending domain needs SPF/DKIM set up in
# Resend or messages will land in spam. Example: "Statement Generator <noreply@dodman.group>"
RESEND_API_KEY=
RESEND_FROM=
# Optional - shown on invoices/emails. Defaults to inquiries@dodman.group.
SUPPORT_EMAIL=
# Optional - protects the admin-only POST /billing/reactivate. Unset = that route is unusable.
INTERNAL_API_SECRET=
# Optional - how often scheduled downgrades / grace periods are processed. Default 3600.
BILLING_RECONCILE_INTERVAL_SECONDS=3600